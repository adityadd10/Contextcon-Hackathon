CRUSTDATA_API_KEY=
# Free LLM via OpenRouter (optional: rule-based fallback is used without it)
OPENROUTER_API_KEY=
# Verified working 31 Oct 11:55 (free tier = 50 requests/day per key, so each member needs their own key)
LLM_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free
# Team's own profile URLs (comma-separated) → enables 1-hop / 2-hop "you → colleague → target" paths
WARMPATH_SEEDS=
# Max Crustdata credits per run, and disk cache (1 = on, makes demo reruns free and deterministic)
WARMPATH_BUDGET=100
WARMPATH_CACHE=1
